<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme - Material 3 -->
    <style name="Theme.ScreenMonitor" parent="Theme.Material3.DayNight">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorPrimaryVariant">@color/md_theme_light_primaryContainer</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/md_theme_light_secondary</item>
        <item name="colorSecondaryVariant">@color/md_theme_light_secondaryContainer</item>
        <item name="colorOnSecondary">@color/md_theme_light_onSecondary</item>

        <!-- Tertiary brand color (Material 3) -->
        <item name="colorTertiary">@color/md_theme_light_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_light_onTertiary</item>

        <!-- Error color -->
        <item name="colorError">@color/md_theme_light_error</item>
        <item name="colorOnError">@color/md_theme_light_onError</item>

        <!-- Surface colors -->
        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorOnSurface">@color/md_theme_light_onSurface</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/md_theme_light_background</item>
        <item name="android:windowBackground">@color/md_theme_light_background</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Enable edge-to-edge -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- Customize your theme here -->
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.ScreenMonitor.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.ScreenMonitor.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.ScreenMonitor.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.ScreenMonitor.ExtraLarge</item>

        <!-- Action bar styling for DarkActionBar look (using MaterialComponents widget) -->
        <item name="actionBarStyle">@style/Widget.ScreenMonitor.ActionBar</item>
    </style>

    <style name="Theme.ScreenMonitor.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Action bar style for DarkActionBar appearance -->
    <style name="Widget.ScreenMonitor.ActionBar" parent="Widget.MaterialComponents.ActionBar.Primary">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="titleTextAppearance">@style/TextAppearance.ScreenMonitor.ActionBarTitle</item>
    </style>

    <style name="TextAppearance.ScreenMonitor.ActionBarTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <!-- Shape appearances for Material 3 -->
    <style name="ShapeAppearance.ScreenMonitor.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item>
    </style>

    <style name="ShapeAppearance.ScreenMonitor.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.ScreenMonitor.Large" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.ScreenMonitor.ExtraLarge" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <!-- Button styles (Material 3) -->
    <style name="Widget.ScreenMonitor.Button.Filled" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingVertical">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.ScreenMonitor.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingVertical">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <style name="Widget.ScreenMonitor.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingVertical">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Card style (MaterialComponents) -->
    <style name="Widget.ScreenMonitor.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
    </style>

    <!-- Text appearance (Material 3) -->
    <style name="TextAppearance.ScreenMonitor.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.ScreenMonitor.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.ScreenMonitor.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="TextAppearance.ScreenMonitor.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextAppearance.ScreenMonitor.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">sans-serif-medium</item>
    </style>
</resources>